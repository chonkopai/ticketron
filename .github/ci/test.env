# Inert, non-secret configuration for automated test runs (CI and local disposable-DB runs).
# DATABASE_URL and the DB test gates are supplied by the caller's environment, which wins over this file.
# No value here is a real credential; providers are disabled or mocked so tests never reach Telegram,
# Resend, translation, map or payment services.
NODE_ENV=test
DEMO_MODE=false
TRANSACTIONAL_NOTIFICATIONS_ENABLED=false
API_PORT=3001
API_TRUST_PROXY_HOPS=1
BOT_PORT=3002
TELEGRAM_BOT_MESSAGES_ENABLED=true
TELEGRAM_BOT_ORGANIZER_ENABLED=true
TELEGRAM_SEAT_MINI_APP_ENABLED=false
TELEGRAM_SEAT_MINI_APP_NAME=seats
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ci_test_bot
API_BASE_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
BOT_INTERNAL_URL=http://localhost:3002
WEB_ORIGIN=http://localhost:3000
TABLE_HOLD_TTL_SECONDS=600
TABLE_HOLD_CLEANUP_INTERVAL_SECONDS=60
CHECKOUT_TTL_SECONDS=900
CHECKOUT_CLEANUP_INTERVAL_SECONDS=60
JWT_SECRET=ci-inert-jwt-secret-not-a-real-credential-0001
JWT_REFRESH_SECRET=ci-inert-jwt-refresh-secret-not-a-real-credential-0002
BOT_API_SECRET=ci-inert-bot-api-secret-not-a-real-credential-0003
ORGANIZER_REQUIRES_APPROVAL=false
EVENT_CONTENT_V2_ENABLED=false
POSTER_STORAGE_DIR=var/test-posters
DRAFT_MEDIA_STORAGE_DIR=var/test-draft-media
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_VIDEO_MAX_SECONDS=60
MEDIA_DRAFT_MAX_BYTES=262144000
TELEGRAM_BOT_TOKEN=000000000:ci-inert-telegram-token
TELEGRAM_BOT_USERNAME=ci_test_bot
TELEGRAM_OIDC_ENABLED=false
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_WEBHOOK_SECRET=ci-inert-telegram-webhook-secret
QUICK_SESSION_TTL_SECONDS=600
QUICK_ACCESS_TTL_SECONDS=2592000
PAYMENT_PROVIDER_NAME=mock
PAYMENT_PROVIDER_WEBHOOK_SECRET=ci-inert-payment-webhook-secret-not-real-0005
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
RESEND_FROM_EMAIL=tickets@mail.example.com
OTP_HMAC_SECRET=ci-inert-otp-hmac-secret-not-a-real-credential-0004
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
GOOGLE_TRANSLATE_API_KEY=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
NEXT_PUBLIC_YANDEX_GEOCODER_ENABLED=false
STAFF_ENABLED=true
STAFF_GATEWAY_SECRET=ci-inert-staff-gateway-secret-not-real-0006
STAFF_MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
