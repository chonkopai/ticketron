# Production settings for deploy/docker-compose.yml.
# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Every variable is explained in docs/configuration.md.
# Generate each secret separately: openssl rand -hex 32

# Hosts. DNS A records for both must point at this server before the first start.
SITE_DOMAIN=staging.example.com
ADMIN_DOMAIN=admin.example.com

# Payments. Only the mock provider exists today (see docs/payments.md).
# The API refuses to start with the mock provider or DEMO_MODE=true unless the
# leftmost label of SITE_DOMAIN marks a demo, staging or test host (for example staging.example.com).
DEMO_MODE=true
PAYMENT_PROVIDER_NAME=mock
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-random-hex

# Internal secrets. Changing the JWT secrets signs everyone out.
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-random-hex-1
JWT_REFRESH_SECRET=replace-with-random-hex-2
BOT_API_SECRET=replace-with-random-hex-3
OTP_HMAC_SECRET=replace-with-random-hex-4

# Telegram bot (BotFather).
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-random-hex
TELEGRAM_BOT_MESSAGES_ENABLED=true
TELEGRAM_BOT_ORGANIZER_ENABLED=true
TELEGRAM_SEAT_MINI_APP_ENABLED=false
TELEGRAM_SEAT_MINI_APP_NAME=seats

# Telegram OIDC login (optional). Register https://<SITE_DOMAIN>/login/telegram/callback first.
TELEGRAM_OIDC_ENABLED=false
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# Automatic purchase and event notifications and reminder scheduling.
TRANSACTIONAL_NOTIFICATIONS_ENABLED=true

# Email (Resend, optional). The sender must use the domain verified in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=tickets@mail.example.com
# RESEND_SENDER_DOMAIN=mail.example.com

# Google sign-in (optional). Both values are the same OAuth client ID.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Maps and address search (optional). NEXT_PUBLIC_* values are built into the web image.
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=
# YANDEX_GEOCODER_API_KEY=
# NEXT_PUBLIC_YANDEX_GEOCODER_ENABLED=true
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# City suggestion from an IP lookup at ipwho.is; get visitor consent before enabling.
# NEXT_PUBLIC_IP_GEOLOCATION_ENABLED=false

# Machine translation of event text (optional): azure or google.
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
# GOOGLE_TRANSLATE_API_KEY=

# Staff console on ADMIN_DOMAIN. Both secrets must differ from every other secret.
STAFF_ENABLED=false
# STAFF_GATEWAY_SECRET=replace-with-random-hex
# STAFF_MFA_ENCRYPTION_KEY=replace-with-64-hex-characters

# Max concurrent ffmpeg/sharp jobs per API process (1-16, default 2).
# MEDIA_PROCESSING_CONCURRENCY=2
